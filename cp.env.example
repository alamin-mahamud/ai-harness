# Copy to $HARNESS_HOME/cp.env (default ~/.claude/harness/cp.env). Sourced by harness-run; chmod 600.
# Needed only for `cp:<model>` backends: Claude Code through a cliproxy-style proxy (see HARNESS_CP_PREFIX below).
# Placeholders only. Put the real key in HARNESS_CP_KEY_FILE (a file holding just the key), never in this file.
export HARNESS_CP_URL=https://cliproxy.example.com:8317
export HARNESS_CP_KEY_FILE="$HOME/.config/harness/cp.key"
# Optional: prefix prepended to the model id (some proxies serve Claude as claude/<model>). Default: empty.
# export HARNESS_CP_PREFIX="claude/"
# Optional: CA bundle if the proxy uses a private CA (leave unset for a public certificate).
# export HARNESS_CP_CA="$HOME/.config/harness/ca.crt"
