# Copy to $HARNESS_HOME/gw.env (default ~/.claude/harness/gw.env). Sourced by harness-run; chmod 600.
# Needed only for `gw:<alias>` (Claude CLI through a gateway) and `oai:<alias>` (direct OpenAI-compatible chat call) backends.
# Placeholders only. Prefer exporting HARNESS_GW_KEY from your secret manager over writing it here.
export HARNESS_GW_URL=https://gateway.example.com
export HARNESS_GW_KEY=replace-me
# Optional: CA bundle if the gateway uses a private CA (leave unset for a public certificate).
# export HARNESS_GW_CA="$HOME/.config/harness/ca.crt"
